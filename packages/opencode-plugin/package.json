{
  "name": "@mnemoshelf/opencode-plugin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Mnemoshelf 的 OpenCode v2 外掛：自動召回相關記憶與選用的回合原文擷取，不需摘要模型",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "eval": "node ./eval/run.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.1.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
