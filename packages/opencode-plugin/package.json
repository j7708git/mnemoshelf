{
  "name": "@mnemoshelf/opencode-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mnemoshelf 的 OpenCode v2 外掛：每次模型請求前自動召回相關記憶；可選的回合結束自動摘要（預設關閉）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "eval": "node ./eval/run.mjs",
    "eval:loop": "node ./eval/loop.mjs",
    "eval:digest": "node ./eval/digest/run.mjs",
    "eval:digest:matrix": "node ./eval/digest/matrix.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.1.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
