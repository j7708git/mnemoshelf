    {
      "id": "beta-version-header",
      "project": "beta",
      "kind": "fact",
      "content": "quota 的回應帶 `X-Quota-Version`（目前 `2.1`），方便 client 判斷行為差異。"
    },
    {
      "id": "beta-idempotency",
      "project": "beta",
      "kind": "decision",
      "content": "quota 對 `POST /v1/consume` 支援 `Idempotency-Key`；同一個 key 在 10 分鐘內重送只扣一次。"
    },
    {
      "id": "gamma-encoding-default",
      "project": "gamma",
      "kind": "decision",
      "content": "sift 讀 CSV 預設用系統編碼（Windows 上是 Big5）。",
      "superseded": true
    },
    {
      "id": "gamma-encoding-utf8",
      "project": "gamma",
      "kind": "decision",
      "content": "sift 讀 CSV 一律以 UTF-8 解碼，遇到 BOM 會自動去掉；其他編碼要用 `--encoding` 明確指定。",
      "supersedes": "gamma-encoding-default"
    },
    {
      "id": "gamma-strict-flag",
      "project": "gamma",
      "kind": "fact",
      "content": "`sift import --strict` 會在第一個欄位數不符的列就中止並印出列號；預設（非 strict）是跳過該列並計數。"
    },
    {
      "id": "gamma-col-error",
      "project": "gamma",
      "kind": "pitfall",
      "content": "`SIFT_COL_07` 表示某列的欄位數與表頭不一致；錯誤訊息會帶 `line` 與 `expected`／`actual`。"
    },
    {
      "id": "gamma-importer-path",
      "project": "gamma",
      "kind": "fact",
      "content": "sift 的匯入邏輯在 `src/importer.ts` 的 `importRows()`；格式判斷在 `src/detect.ts`。"
    },
    {
      "id": "gamma-null-handling",
      "project": "gamma",
      "kind": "decision",
      "content": "空字串欄位一律存成空字串。",
      "superseded": true
    },
    {
      "id": "gamma-null-empty",
      "project": "gamma",
      "kind": "decision",
      "content": "空白與 `NULL` 字面值都轉成 null，只有加引號的空字串保留為空字串；這是為了讓下游 SQL 的 `IS NULL` 有意義。",
      "supersedes": "gamma-null-handling"
    },
    {
      "id": "gamma-large-file",
      "project": "gamma",
      "kind": "pitfall",
      "content": "sift 逐行串流處理，不會把整個檔讀進記憶體；但 `--sort` 會把資料寫到暫存檔再排序，大檔要注意磁碟空間。"
    },
    {
      "id": "gamma-schema-version",
      "project": "gamma",
      "kind": "fact",
      "content": "sift 的輸出 schema 版本是 `1`，寫在輸出的第一行。",
      "superseded": true
    },
    {
      "id": "gamma-schema-v2",
      "project": "gamma",
      "kind": "fact",
      "content": "sift 的輸出 schema 版本升到 `2`：新增 `ingestedAt` 與 `rowHash` 兩個欄位，舊的 `1` 仍可讀但不再產生。",
      "supersedes": "gamma-schema-version"
    },
    {
      "id": "gamma-date-format",
      "project": "gamma",
      "kind": "preference",
      "content": "sift 的日期輸出用 `YYYY/MM/DD`。",
      "superseded": true
    },
    {
      "id": "gamma-date-iso",
      "project": "gamma",
      "kind": "preference",
      "content": "sift 的日期輸出改用 ISO 8601（`YYYY-MM-DD`），時區一律 UTC；`--local-time` 才轉本地。",
      "supersedes": "gamma-date-format"
    },
    {
      "id": "gamma-dry-run",
      "project": "gamma",
      "kind": "fact",
      "pinned": true,
      "content": "sift 支援 `--dry-run`：只驗證與統計，不寫入輸出檔；CI 用它檢查上游格式有沒有壞。"
    },
    {
      "id": "gamma-delimiter",
      "project": "gamma",
      "kind": "pitfall",
      "content": "sift 只支援逗號分隔，分號要自己先轉。",
      "superseded": true
    },
    {
      "id": "gamma-delimiter-sniff",
      "project": "gamma",
      "kind": "pitfall",
      "content": "sift 會自動偵測逗號、分號與 Tab（取樣前 100 行），也可用 `--delimiter` 強制指定。",
      "supersedes": "gamma-delimiter"
    },
    {
      "id": "gamma-dup-rows",
      "project": "gamma",
      "kind": "fact",
      "content": "sift 預設保留重複列；要折疊重複得加 `--dedupe --key <欄位>`。"
    },
    {
      "id": "gamma-batch-size",
      "project": "gamma",
      "kind": "fact",
      "content": "sift 寫入批次大小預設 500 列，可用 `--batch-size` 調整；太大會讓失敗時的重試成本變高。"
    },
    {
      "id": "gamma-header-normalize",
      "project": "gamma",
      "kind": "decision",
      "content": "sift 保留表頭原樣，不修剪空白。",
      "superseded": true
    },
    {
      "id": "gamma-header-trim",
      "project": "gamma",
      "kind": "decision",
      "content": "sift 會 trim 表頭空白、把內部連續空白換成單一底線，並轉小寫；原始表頭記在輸出的 `_source_header`。",
      "supersedes": "gamma-header-normalize"
    },
    {
      "id": "gamma-memory-limit",
      "project": "gamma",
      "kind": "pitfall",
      "content": "sift 遇到超過 200 MB 的單一欄位會回 `SIFT_SIZE_11`；這是保護，不要用 `--no-limit` 繞過，先確認上游格式。"
    },
    {
      "id": "gamma-reject-card-a",
      "project": "gamma",
      "kind": "fact",
      "content": "sift 的失敗列會寫到 `<output>.rejects.ndjson`。"
    },
    {
      "id": "gamma-reject-card-b",
      "project": "gamma",
      "kind": "fact",
      "force": true,
      "content": "sift 把無法解析的列寫進 `<output>.rejects.ndjson`，每行一筆。"
    },
    {
      "id": "gamma-pin-schema",
      "project": "gamma",
      "kind": "decision",
      "pinned": true,
      "content": "sift 的輸出欄位順序是契約的一部分（下游用位置解析）；新增欄位只能加在最後，不可重排。"
