  "cards": [
    {
      "dot": "cyan",
      "title": "入口",
      "items": [
        "OpenCode／OpenChamber 外掛在模型請求前自動召回，只召回、不寫入",
        "agent 走 MCP，不支援者用 REST 或 skill",
        "UI 與 MCP 都只透過本機 HTTP 連 REST"
      ]
    },
    {
      "dot": "amber",
      "title": "連線發現",
      "items": [
        "runtime.json 由服務啟動時寫出，權限 0600、內含全權 token",
        "桌面版預設開啟，可關；關閉即刪除檔案",
        "外掛先驗 /health 身分與 pid 才送出 token"
      ]
    },
    {
      "dot": "emerald",
      "title": "資料",
      "items": [
        "MetadataStore 與 VectorIndex 可獨立替換",
        "混合排序在應用層，後端只回傳各自的排名"
      ]
    },
    {
      "dot": "rose",
      "title": "安全",
      "items": [
        "預設不掃任何目錄，必須逐一加入 root",
        "realpath 驗證與黑名單，機密先遮罩再索引",
        "召回內容不進 session 歷史；逾時或索引中 fail-open"
      ]
    }
  ]
