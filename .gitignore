# 機密與本地設定（一律不進版控）
.env
.env.*
!.env.example

# 臨時產物
.tmp/
.scratch/
.local/

# 內部工作紀錄（OpenChamber）
.openchamber/

# Node
node_modules/
dist/
out/
*.log

# 本機資料庫與模型
*.db
*.db-wal
*.db-shm
models/

# 實機崩潰報告與診斷檔（使用者從 Mac／Windows 上傳的證據，一律不進版控）
*.ips
mac_report/

# 一次性探測殘檔（例如端點探測回來的錯誤回應本體），不進版控
probe-model.json

# staging 原子替換的暫存／備份目錄（強殺或斷電時可能殘留；內含 FFmpeg binary，禁止進版控）
packages/desktop/media-bin.staging-*/
packages/desktop/media-bin.old-*/
